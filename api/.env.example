# PostgreSQL. Locally this is your own server; deployed it is the managed
# connection string. Whichever provider you use, swap the postgresql://
# scheme for postgresql+psycopg:// so SQLAlchemy uses psycopg 3 — that is
# the only edit the URL needs.
#
#   Pxxl     — `pxxl db create --name nnneva-db --type postgres`, then
#              `pxxl db get nnneva-db` and take the "Database URL" row.
#   Supabase — Project settings → Database → Connection string.
DATABASE_URL="postgresql+psycopg://nnneva:nnneva@localhost:5432/nnneva"

# Which planner the agent uses:
#   auto     — call a model when one is configured, deterministic planner if it fails
#   model    — require a model; a failure returns 502 instead of falling back.
#              Set this when credentials come from an IAM role rather than
#              keys, because "auto" only looks for explicit keys.
#   bedrock  — the old name for "model", still accepted
#   scripted — never call a model (works with no AWS account at all)
AGENT_ENGINE="auto"

# AWS Bedrock — the first model the Strands agent reasons with.
#
# On-demand Anthropic models are reachable only through a regional inference
# profile, so the id needs the "us." prefix. A bare "anthropic.claude-..." id
# is accepted by the SDK and then rejected at invoke time, which reads like an
# outage rather than a typo.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Tried when the one above does not answer. Same credentials, so it needs
# nothing extra. Empty to run on a single model.
BEDROCK_FALLBACK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
# Ask Bedrock which ids this account can invoke and use the matching model it
# really has, rather than the string above verbatim. Needs
# bedrock:ListFoundationModels and bedrock:ListInferenceProfiles.
BEDROCK_DISCOVER="true"

# OpenAI — tried when Bedrock fails. Leave the key empty to run on Bedrock
# alone; nothing calls OpenAI without it.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.3-mini"

# DeepSeek, through its OpenAI-compatible endpoint. `deepseek-chat` is an
# alias DeepSeek keeps pointed at their current model, which is safer than a
# version string that goes stale and then fails at call time.
#
# This is the one provider that sends a pregnancy's details outside your own
# infrastructure, under DeepSeek's terms rather than yours. Off without a key.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Which providers to try, in order. Bedrock leads by default because it runs
# inside your own AWS account. Set "deepseek,bedrock" to lead with DeepSeek.
MODEL_PRIORITY="bedrock,deepseek,openai"

# Session signing. Must be at least 32 bytes — generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# Where the web app runs, for CORS
WEB_ORIGIN="http://localhost:3000"

# Google sign-in, brokered by Supabase Auth. The API only verifies the access
# token Supabase issued, so it needs no Google credentials at all. Must be the
# SAME project the web app points at. Blank means POST /auth/supabase is 501.
SUPABASE_URL="https://<project-ref>.supabase.co"

# Only for projects still signing JWTs with a shared secret. Modern projects
# use asymmetric keys published at /auth/v1/.well-known/jwks.json and need
# nothing here — leave it blank and try that first.
SUPABASE_JWT_SECRET=""
